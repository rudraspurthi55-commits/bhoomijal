# Bhoomijal Environment Configuration
PROJECT_NAME="Bhoomijal"
APP_ENV="development"
DEBUG=true

# Database
DATABASE_URL="sqlite:///./bhoomijal.db"

# API & Server
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["*"]

# Machine Learning
MODEL_DIR="./models"
MODEL_FILENAME="groundwater_predictor.joblib"
RETRAIN_THRESHOLD_NEW_ROWS=50
DATA_SOURCE_SIMULATION_FLAG=true
